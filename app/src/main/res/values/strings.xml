    <string name="about_view_full">About AzazelsExplorer</string>
    <string name="about_description">A file manager and media downloader for Android. Organize your files, download media from social platforms, and explore your device with a clean, themed interface.</string>
    <string name="about_section_features">Features</string>
    <string name="about_features_list">• Full filesystem browser with sort, filter, and search\n• Storage breakdown with donut chart\n• Quick access categories (Photos, Videos, Audio, Docs)\n• Media downloader (TikTok, Instagram, X, Facebook, Reddit)\n• File organizer with preview and batch move\n• ZIP viewer with extract and share\n• Image viewer with pinch-to-zoom\n• Light and dark themes</string>
    <string name="about_section_tech">Built With</string>
    <string name="about_tech_list">• Kotlin + Material Design 3\n• Jetpack Navigation Component\n• Retrofit + Gson (networking)\n• Glide + PhotoView (images)\n• Supabase (authentication)\n• Android DownloadManager</string>
    <string name="downloader_url_guidance"><b>TikTok:</b> vt.tiktok.com/… or vm.tiktok.com/… (use share links)\n<b>Instagram:</b> instagram.com/reel/… or /p/…\n<b>X/Twitter:</b> x.com/…/status/…\n<b>Facebook:</b> facebook.com/…/videos/… or fb.watch/…\n<b>Vimeo:</b> vimeo.com/…\n<b>Reddit:</b> reddit.com/r/…\n<b>Direct:</b> any URL ending in .mp4, .jpg, .png, etc.\n<b>Not supported:</b> YouTube (youtube.com, youtu.be)</string>
